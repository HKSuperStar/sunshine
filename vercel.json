{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/cases/eureka",
      "destination": "/cases/robot-vacuum",
      "permanent": true
    },
    {
      "source": "/cases/eureka/",
      "destination": "/cases/robot-vacuum/",
      "permanent": true
    },
    {
      "source": "/en/cases/eureka",
      "destination": "/en/cases/robot-vacuum",
      "permanent": true
    },
    {
      "source": "/en/cases/eureka/",
      "destination": "/en/cases/robot-vacuum/",
      "permanent": true
    }
  ]
}
